{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "CorsConfiguration": {
    "AllowedOrigins": [
      "https://staging.migenteenlinea.com",
      "https://www.staging.migenteenlinea.com"
    ],
    "AllowCredentials": true,
    "AllowedMethods": [],
    "AllowedHeaders": [],
    "ExposedHeaders": ["X-Pagination", "X-Total-Count"],
    "MaxAgeSeconds": 600
  },
  "DatabaseInitialization": {
    "ApplyMigrationsOnStartup": false,
    "RunCatalogSeedOnStartup": true,
    "RunDemoSeedOnStartup": false,
    "FailFastOnInitializationError": true
  },
  "DatabaseSeedingSecurity": {
    "Enabled": true,
    "RequireHeaderKey": true,
    "HeaderName": "X-Seed-Key",
    "HeaderValue": "CHANGE_ME_STAGING_SEED_KEY",
    "AllowDemoSeedInProduction": false
  }
}
