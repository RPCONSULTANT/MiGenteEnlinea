@*
    Calificación de Perfiles - Empleador
    EXACTO al: FRONT_Publicado/Empleador/CalificacionDePerfiles.aspx
    Tema: Argon Dashboard 2.0
*@
@{
    ViewData["Title"] = "Calificación de Perfiles";
    Layout = "_LayoutEmpleador";
}

@section Styles {
    <style>
        .star {
            font-size: 24px;
            color: #ccc;
            cursor: pointer;
            transition: color 0.2s;
        }
        .star.filled,
        .star.hover {
            color: #ffc107;
        }
        .star-display {
            font-size: 18px;
        }
    </style>
}

<!-- Título de la sección -->
<div class="container mt-1">
    <div class="section-title justify-content-center" style="text-align: center;">
        <h2 class="text-white">Calificación de Perfiles</h2>
    </div>
    
    <!-- Cards de acciones -->
    <div class="row">
        <!-- Card Calificar Perfil -->
        <div class="col-md-6 mt-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Calificar Perfil</h5>
                    <i class="fas fa-star fa-5x text-warning mb-3"></i>
                    <p class="card-text">Califica perfiles y se colabora al crecimiento de esta gran comunidad.</p>
                    <button type="button" data-bs-toggle="modal" data-bs-target="#modalCalificar" class="btn btn-primary">Calificar</button>
                </div>
            </div>
        </div>
        
        <!-- Card Consultar Perfiles -->
        <div class="col-md-6 mt-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">Consultar Perfiles</h5>
                    <i class="fas fa-search fa-5x text-primary mb-3"></i>
                    <p class="card-text">Utiliza el directorio para buscar y consultar perfiles.</p>
                    <a href="#" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalConsultarPerfil">Consultar</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Sección Mis Calificaciones -->
<div class="container mt-6 align-content-center" style="text-align: center">
    <h3>Mis calificaciones</h3>
    
    <div class="table-responsive">
        <div class="card">
            <table class="table table-bordered table-sm" id="gridCalificaciones">
                <thead>
                    <tr>
                        <th scope="col">Fecha</th>
                        <th scope="col">Identificación</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Puntualidad</th>
                        <th scope="col">Conocimientos</th>
                        <th scope="col">Cumplimiento</th>
                        <th scope="col">Recomendación</th>
                    </tr>
                </thead>
                <tbody id="tbodyCalificaciones">
                    <tr class="empty-data-row">
                        <td colspan="7">
                            <div>No data to display</div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Calificar Perfil -->
<div class="modal fade" id="modalCalificar" tabindex="-1" aria-labelledby="modalCalificarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title text-white" id="modalCalificarLabel">Calificar Perfil</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Selector de perfil -->
                <div class="mb-3">
                    <label for="ddlPerfil" class="form-label">Seleccione Perfil para Calificar</label>
                    <select id="ddlPerfil" class="form-select" onchange="onPerfilSeleccionado()">
                        <option value="">-- Seleccione un perfil --</option>
                    </select>
                </div>
                
                <!-- RNC/Cédula -->
                <div class="mb-3">
                    <label for="calif_identificacion" class="form-label">RNC/Cédula</label>
                    <input type="text" class="form-control" id="calif_identificacion" disabled />
                </div>
                
                <!-- Nombre -->
                <div class="mb-3">
                    <label for="calif_nombre" class="form-label">Nombre</label>
                    <input type="text" class="form-control" id="calif_nombre" disabled />
                </div>
                
                <!-- Rating Puntualidad -->
                <div class="mb-3">
                    <label class="form-label">¿Cuántas estrellas le das a su puntualidad?</label>
                    <div class="rating-input" id="ratingPuntualidad">
                        <i class="fas fa-star star" data-value="1"></i>
                        <i class="fas fa-star star" data-value="2"></i>
                        <i class="fas fa-star star" data-value="3"></i>
                        <i class="fas fa-star star" data-value="4"></i>
                        <i class="fas fa-star star" data-value="5"></i>
                    </div>
                    <input type="hidden" id="valorPuntualidad" value="0">
                </div>
                
                <!-- Rating Cumplimiento -->
                <div class="mb-3">
                    <label class="form-label">¿Qué te pareció el Servicio Recibido?</label>
                    <div class="rating-input" id="ratingCumplimiento">
                        <i class="fas fa-star star" data-value="1"></i>
                        <i class="fas fa-star star" data-value="2"></i>
                        <i class="fas fa-star star" data-value="3"></i>
                        <i class="fas fa-star star" data-value="4"></i>
                        <i class="fas fa-star star" data-value="5"></i>
                    </div>
                    <input type="hidden" id="valorCumplimiento" value="0">
                </div>
                
                <!-- Rating Conocimientos -->
                <div class="mb-3">
                    <label class="form-label">¿Cómo calificas sus conocimientos profesionales?</label>
                    <div class="rating-input" id="ratingConocimientos">
                        <i class="fas fa-star star" data-value="1"></i>
                        <i class="fas fa-star star" data-value="2"></i>
                        <i class="fas fa-star star" data-value="3"></i>
                        <i class="fas fa-star star" data-value="4"></i>
                        <i class="fas fa-star star" data-value="5"></i>
                    </div>
                    <input type="hidden" id="valorConocimientos" value="0">
                </div>
                
                <!-- Rating Recomendación -->
                <div class="mb-3">
                    <label class="form-label">¿Qué tanto lo recomendarías?</label>
                    <div class="rating-input" id="ratingRecomendacion">
                        <i class="fas fa-star star" data-value="1"></i>
                        <i class="fas fa-star star" data-value="2"></i>
                        <i class="fas fa-star star" data-value="3"></i>
                        <i class="fas fa-star star" data-value="4"></i>
                        <i class="fas fa-star star" data-value="5"></i>
                    </div>
                    <input type="hidden" id="valorRecomendacion" value="0">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnRealizarCalificacion" disabled onclick="calificarPerfil()">Realizar Calificacion</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Consultar Perfil -->
<div class="modal fade" id="modalConsultarPerfil" tabindex="-1" aria-labelledby="modalConsultarPerfilLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title text-white" id="modalConsultarPerfilLabel">Consultar Perfil</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="txtConsultarId" class="form-label">Identificación</label>
                    <input type="text" class="form-control" id="txtConsultarId" placeholder="RNC/Cédula" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="consultarPerfil()">Consultar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Perfil Encontrado -->
<div class="modal fade" id="modalPerfilEncontrado" tabindex="-1" aria-labelledby="modalPerfilEncontradoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title text-white" id="modalPerfilEncontradoLabel">Perfil Encontrado</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-4">
                    <i class="fas fa-user fa-5x text-secondary mb-3"></i>
                    <p class="mb-1"><strong>Tipo:</strong> <span id="perfil_tipo">Contratista</span></p>
                    <p class="mb-1"><strong>Identificación:</strong> <span id="perfil_identificacion">-</span></p>
                    <p class="mb-3"><strong>Nombre:</strong> <span id="perfil_nombre">-</span></p>
                </div>
                
                <hr>
                
                <div class="row">
                    <div class="col-12">
                        <div class="mb-2">
                            <span class="me-2"><strong>Puntualidad:</strong></span>
                            <span class="star-display" id="display_puntualidad"></span>
                        </div>
                        <div class="mb-2">
                            <span class="me-2"><strong>Cumplimiento:</strong></span>
                            <span class="star-display" id="display_cumplimiento"></span>
                        </div>
                        <div class="mb-2">
                            <span class="me-2"><strong>Conocimientos:</strong></span>
                            <span class="star-display" id="display_conocimientos"></span>
                        </div>
                        <div class="mb-2">
                            <span class="me-2"><strong>Recomendación:</strong></span>
                            <span class="star-display" id="display_recomendacion"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let perfilesCalificables = [];

        document.addEventListener('DOMContentLoaded', function () {
            configurarRatings();
            cargarMisCalificaciones();
            cargarPerfilesCalificables();
        });

        function configurarRatings() {
            document.querySelectorAll('.rating-input .star').forEach(star => {
                star.addEventListener('click', function () {
                    const container = this.parentElement;
                    const value = parseInt(this.dataset.value, 10);
                    const inputId = container.id.replace('rating', 'valor');
                    document.getElementById(inputId).value = value;
                    pintarRating(container, value);
                    verificarFormulario();
                });

                star.addEventListener('mouseenter', function () {
                    pintarRating(this.parentElement, parseInt(this.dataset.value, 10), true);
                });
            });

            document.querySelectorAll('.rating-input').forEach(container => {
                container.addEventListener('mouseleave', function () {
                    const inputId = this.id.replace('rating', 'valor');
                    pintarRating(this, parseInt(document.getElementById(inputId).value || '0', 10));
                });
            });
        }

        function pintarRating(container, value, hover = false) {
            container.querySelectorAll('.star').forEach(star => {
                const shouldFill = parseInt(star.dataset.value, 10) <= value;
                star.classList.toggle('filled', !hover && shouldFill);
                star.classList.toggle('hover', hover && shouldFill);
                if (!shouldFill) {
                    star.classList.remove('hover');
                }
            });
        }

        async function cargarMisCalificaciones() {
            const userId = getUserIdFromToken();
            if (!userId) return;

            try {
                const path = window.API_ENDPOINTS?.CALIFICACIONES?.POR_EMPLEADOR
                    ? window.API_ENDPOINTS.CALIFICACIONES.POR_EMPLEADOR(userId)
                    : `/calificaciones/por-empleador/${userId}`;
                const response = await authenticatedFetch(path);
                const data = window.readApiResponse ? await window.readApiResponse(response) : await response.json();
                renderizarTablaCalificaciones(Array.isArray(data) ? data : []);
            } catch (error) {
                console.error('Error cargando calificaciones:', error);
                renderizarTablaCalificaciones([]);
            }
        }

        async function cargarPerfilesCalificables() {
            try {
                const path = window.API_ENDPOINTS?.CONTRATACIONES?.NO_CALIFICADAS || '/contrataciones?soloNoCalificadas=true&pageSize=100';
                const response = await authenticatedFetch(path);
                const data = window.readApiResponse ? await window.readApiResponse(response) : await response.json();
                const items = Array.isArray(data) ? data : (data?.items || []);

                perfilesCalificables = items.map(item => ({
                    id: item.detalleId || item.id || item.contratacionId,
                    identificacion: item.contratistaIdentificacion || item.identificacion || '',
                    nombre: item.contratistaNombre || item.contratistaCompleteName || item.nombreCompleto || 'Contratista',
                    descripcion: item.descripcionCorta || item.servicio || item.categoria || 'Perfil disponible para calificar'
                })).filter(item => item.identificacion);

                llenarDropdownPerfiles();
            } catch (error) {
                console.error('Error cargando perfiles calificables:', error);
                llenarDropdownPerfiles();
            }
        }

        function llenarDropdownPerfiles() {
            const ddl = document.getElementById('ddlPerfil');
            ddl.innerHTML = '<option value="">-- Seleccione un perfil --</option>';

            perfilesCalificables.forEach(perfil => {
                const option = document.createElement('option');
                option.value = String(perfil.id || perfil.identificacion);
                option.dataset.identificacion = perfil.identificacion;
                option.dataset.nombre = perfil.nombre;
                option.textContent = `${perfil.nombre} (${perfil.descripcion})`;
                ddl.appendChild(option);
            });
        }

        function onPerfilSeleccionado() {
            const selected = document.querySelector('#ddlPerfil option:checked');
            const hasValue = selected && selected.value;

            document.getElementById('calif_identificacion').value = hasValue ? (selected.dataset.identificacion || '') : '';
            document.getElementById('calif_nombre').value = hasValue ? (selected.dataset.nombre || '') : '';
            verificarFormulario();
        }

        function verificarFormulario() {
            const perfilId = document.getElementById('ddlPerfil').value;
            const valores = ['valorPuntualidad', 'valorCumplimiento', 'valorConocimientos', 'valorRecomendacion']
                .map(id => parseInt(document.getElementById(id).value || '0', 10));

            document.getElementById('btnRealizarCalificacion').disabled = !perfilId || valores.some(v => v <= 0);
        }

        async function calificarPerfil() {
            const empleadorUserId = getUserIdFromToken();
            const contratistaIdentificacion = document.getElementById('calif_identificacion').value.trim();

            if (!empleadorUserId || !contratistaIdentificacion) {
                Swal.fire('Error', 'No se pudo identificar el perfil a calificar.', 'error');
                return;
            }

            const payload = {
                empleadorUserId,
                contratistaIdentificacion,
                puntualidad: parseInt(document.getElementById('valorPuntualidad').value || '0', 10),
                cumplimiento: parseInt(document.getElementById('valorCumplimiento').value || '0', 10),
                conocimientos: parseInt(document.getElementById('valorConocimientos').value || '0', 10),
                recomendacion: parseInt(document.getElementById('valorRecomendacion').value || '0', 10)
            };

            try {
                const path = window.API_ENDPOINTS?.CALIFICACIONES?.CALIFICAR_PERFIL || '/calificaciones/calificar-perfil';
                const response = await authenticatedFetch(path, {
                    method: 'POST',
                    body: JSON.stringify(payload)
                });

                const result = window.readApiResponse ? await window.readApiResponse(response) : await response.json();
                if (!response.ok) {
                    throw new Error(result?.message || 'No se pudo guardar la calificación.');
                }

                bootstrap.Modal.getInstance(document.getElementById('modalCalificar'))?.hide();
                limpiarFormularioCalificacion();
                await cargarMisCalificaciones();
                await cargarPerfilesCalificables();
                Swal.fire('Éxito', 'La calificación fue registrada correctamente.', 'success');
            } catch (error) {
                Swal.fire('Error', error.message || 'No se pudo guardar la calificación.', 'error');
            }
        }

        function limpiarFormularioCalificacion() {
            document.getElementById('ddlPerfil').value = '';
            document.getElementById('calif_identificacion').value = '';
            document.getElementById('calif_nombre').value = '';
            ['valorPuntualidad', 'valorCumplimiento', 'valorConocimientos', 'valorRecomendacion'].forEach(id => {
                document.getElementById(id).value = '0';
            });
            document.querySelectorAll('.rating-input').forEach(container => pintarRating(container, 0));
            document.getElementById('btnRealizarCalificacion').disabled = true;
        }

        async function consultarPerfil() {
            const identificacion = document.getElementById('txtConsultarId').value.trim();
            if (!identificacion) {
                Swal.fire('Error', 'Por favor ingrese una identificación.', 'warning');
                return;
            }

            try {
                const [perfilResponse, promedioResponse] = await Promise.all([
                    authenticatedFetch(`/contratistas?searchTerm=${encodeURIComponent(identificacion)}&pageSize=20`),
                    authenticatedFetch(`/calificaciones/promedio/${encodeURIComponent(identificacion)}`)
                ]);

                const perfilData = window.readApiResponse ? await window.readApiResponse(perfilResponse) : await perfilResponse.json();
                const promedioData = promedioResponse.ok
                    ? (window.readApiResponse ? await window.readApiResponse(promedioResponse) : await promedioResponse.json())
                    : null;

                const perfiles = Array.isArray(perfilData) ? perfilData : (perfilData?.items || []);
                const perfil = perfiles.find(item => (item.identificacion || '').replace(/\D/g, '') === identificacion.replace(/\D/g, ''))
                    || perfiles[0];

                if (!perfil) {
                    throw new Error('No se encontró un perfil con esa identificación.');
                }

                mostrarModalPerfil({
                    tipo: 'Contratista',
                    identificacion: perfil.identificacion || identificacion,
                    nombre: `${perfil.nombre || ''} ${perfil.apellido || ''}`.trim() || perfil.nombreComercial || perfil.titulo || 'Perfil encontrado',
                    puntualidad: promedioData?.promedioPuntualidad || 0,
                    cumplimiento: promedioData?.promedioCumplimiento || 0,
                    conocimientos: promedioData?.promedioConocimientos || 0,
                    recomendacion: promedioData?.promedioRecomendacion || 0
                });
            } catch (error) {
                Swal.fire('Error', error.message || 'Perfil no encontrado.', 'error');
            }
        }

        function mostrarModalPerfil(perfil) {
            bootstrap.Modal.getInstance(document.getElementById('modalConsultarPerfil'))?.hide();

            document.getElementById('perfil_tipo').textContent = perfil.tipo;
            document.getElementById('perfil_identificacion').textContent = perfil.identificacion;
            document.getElementById('perfil_nombre').textContent = perfil.nombre;
            document.getElementById('display_puntualidad').innerHTML = convertirANumeroEstrellas(Math.round(perfil.puntualidad || 0));
            document.getElementById('display_cumplimiento').innerHTML = convertirANumeroEstrellas(Math.round(perfil.cumplimiento || 0));
            document.getElementById('display_conocimientos').innerHTML = convertirANumeroEstrellas(Math.round(perfil.conocimientos || 0));
            document.getElementById('display_recomendacion').innerHTML = convertirANumeroEstrellas(Math.round(perfil.recomendacion || 0));

            new bootstrap.Modal(document.getElementById('modalPerfilEncontrado')).show();
        }

        function renderizarTablaCalificaciones(calificaciones) {
            const tbody = document.getElementById('tbodyCalificaciones');
            tbody.innerHTML = '';

            if (!calificaciones.length) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            No hay calificaciones registradas.
                        </td>
                    </tr>
                `;
                return;
            }

            calificaciones.forEach(c => {
                tbody.innerHTML += `
                    <tr>
                        <td>${formatearFecha(c.fecha)}</td>
                        <td>${c.contratistaIdentificacion || '-'}</td>
                        <td>${c.contratistaNombre || '-'}</td>
                        <td>${convertirANumeroEstrellas(c.puntualidad || 0)}</td>
                        <td>${convertirANumeroEstrellas(c.conocimientos || 0)}</td>
                        <td>${convertirANumeroEstrellas(c.cumplimiento || 0)}</td>
                        <td>${convertirANumeroEstrellas(c.recomendacion || 0)}</td>
                    </tr>
                `;
            });
        }

        function getUserIdFromToken() {
            const token = localStorage.getItem('accessToken') || localStorage.getItem('token') || sessionStorage.getItem('token');
            if (!token) return null;

            try {
                const base64Url = token.split('.')[1];
                const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
                const jsonPayload = decodeURIComponent(atob(base64).split('').map(c => `%${(`00${c.charCodeAt(0).toString(16)}`).slice(-2)}`).join(''));
                const payload = JSON.parse(jsonPayload);
                return payload.nameid || payload.sub || payload.userId || null;
            } catch (error) {
                console.error('Error decoding token:', error);
                return null;
            }
        }

        function convertirANumeroEstrellas(valor) {
            let html = '';
            for (let i = 1; i <= 5; i++) {
                html += i <= valor
                    ? '<i class="fas fa-star text-warning"></i>'
                    : '<i class="far fa-star text-muted"></i>';
            }
            return html;
        }

        function formatearFecha(fecha) {
            if (!fecha) return '-';
            return new Date(fecha).toLocaleDateString('es-DO');
        }
    </script>
}

