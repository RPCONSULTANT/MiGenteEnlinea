        // ============================================
        // HELPERS
        // ============================================
        function formatDate(dateStr) {
            if (!dateStr) return '-';
            try {
                return new Date(dateStr).toLocaleDateString('es-DO');
            } catch {
                return dateStr;
            }
        }
        
        function getStatusName(estatus) {
            const estados = {
                1: 'Pendiente',
                2: 'Aceptada',
                3: 'En Progreso',
                4: 'Completada',
                5: 'Cancelada',
                6: 'Rechazada'
            };
            return estados[estatus] || 'Desconocido';
        }
        
        function getStatusBadge(estatus) {
            const badges = {
                1: 'warning',
                2: 'info',
                3: 'primary',
                4: 'success',
                5: 'danger',
                6: 'secondary'
            };
            return badges[estatus] || 'secondary';
        }

        function getFichaTemporalUrl(item) {
            const detalleId = Number(item?.detalleId || 0);
            const contratacionId = Number(item?.contratacionId || 0);
            const query = `detalleId=${detalleId}${contratacionId ? `&contratacionId=${contratacionId}` : ''}`;
            return `@Url.Action("FichaColaboradorTemporal", "Empleador")?${query}`;
        }

        function exportarContrataciones(scope) {
            const map = {
                pendientes: allPendientes,
                aceptadas: allAceptadas,
                progreso: allActivas,
                completadas: allCompletadas,
                canceladas: allCanceladas
            };
            const rows = map[scope] || [];
            if (!rows.length) {
                Swal.fire('Sin datos', 'No hay contrataciones para exportar.', 'info');
                return;
            }

            const headers = ['DetalleId', 'ContratacionId', 'Estado', 'Descripcion', 'Contratista', 'FechaInicio', 'FechaFin', 'Monto'];
            const lines = rows.map(r => [
                r.detalleId ?? '',
                r.contratacionId ?? '',
                escapeCsv(r.nombreEstado || getStatusName(r.estatus)),
                escapeCsv(r.descripcionCorta),
                escapeCsv(r.contratistaCompleteName),
                r.fechaInicio ? new Date(r.fechaInicio).toISOString().split('T')[0] : '',
                r.fechaFinal ? new Date(r.fechaFinal).toISOString().split('T')[0] : '',
                Number(r.montoAcordado || 0).toFixed(2)
            ].join(','));

            const csv = [headers.join(','), ...lines].join('\n');
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `contrataciones-${scope}.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        function escapeCsv(value) {
            const raw = value == null ? '' : String(value);
            return `"${raw.replace(/"/g, '""')}"`;
        }
        
        // ============================================
        // FORMULARIO NUEVA CONTRATACIÓN
        // ============================================
        function initFormEvents() {
            loadContratistasForModal();

            // Character counters
            document.getElementById('descripcionCorta').addEventListener('input', function(e) {
                document.getElementById('descripcionCortaCount').textContent = e.target.value.length;
            });
            
            document.getElementById('descripcionAmpliada').addEventListener('input', function(e) {
                document.getElementById('descripcionAmpliadaCount').textContent = e.target.value.length;
            });
            
            // Monto formatting
            document.getElementById('montoAcordado').addEventListener('blur', function(e) {
                const value = parseFloat(e.target.value.replace(/,/g, ''));
                if (!isNaN(value)) {
                    e.target.value = value.toLocaleString('en-US', {minimumFractionDigits: 2});
                }
            });
            
            // Set default dates
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('fechaInicio').value = today;
            document.getElementById('fechaInicio').min = today;
            
            // Guardar contratación
            document.getElementById('btnGuardarContratacion').addEventListener('click', crearContratacion);
            document.getElementById('contratistaSelect').addEventListener('change', onContratistaChange);
            
            // Reset form on modal close
            document.getElementById('modalNuevaContratacion').addEventListener('hidden.bs.modal', resetForm);
            document.getElementById('modalNuevaContratacion').addEventListener('shown.bs.modal', hydratePreselectedContratista);
            
            // Search handlers
            document.getElementById('searchPendientes').addEventListener('input', filterPendientes);
            document.getElementById('searchAceptadas').addEventListener('input', filterAceptadas);
            document.getElementById('searchActivas').addEventListener('input', filterActivas);
            document.getElementById('searchCompletadas').addEventListener('input', filterCompletadas);
        }

        async function loadContratistasForModal() {
            try {
                const listPath = '/contratistas?soloActivos=true&pageSize=200';
                const response = await authenticatedFetch(listPath);
                if (!response.ok) {
                    return;
                }

                const payload = window.readApiResponse ? await window.readApiResponse(response) : await response.json();
                const items = payload?.items || payload?.contratistas || payload || [];
                modalContratistas = Array.isArray(items) ? items : [];

                const select = document.getElementById('contratistaSelect');
                select.innerHTML = '<option value="">-- Seleccione un contratista --</option>' +
                    modalContratistas.map(c => {
                        const nombre = c.nombreCompleto || `${c.nombre || ''} ${c.apellido || ''}`.trim() || `Contratista #${c.contratistaId}`;
                        const rating = c.promedioCalificacion ? ` (${Number(c.promedioCalificacion).toFixed(1)}★)` : '';
                        return `<option value="${c.contratistaId}">${nombre}${rating}</option>`;
                    }).join('');

                hydratePreselectedContratista();
            } catch (error) {
                console.error('Error cargando contratistas para modal:', error);
            }
        }

        function hydratePreselectedContratista() {
            const hireIntentRaw = sessionStorage.getItem('mge:hireIntent');
            if (hireIntentRaw) {
                try {
                    const intent = JSON.parse(hireIntentRaw);
                    if (intent?.tipoContratacion === 'temporal' && intent?.contratistaId) {
                        const select = document.getElementById('contratistaSelect');
                        if (select.querySelector(`option[value="${intent.contratistaId}"]`)) {
                            select.value = String(intent.contratistaId);
                            onContratistaChange();
                            pendingHireIntent = null;
                        }
                        sessionStorage.removeItem('mge:hireIntent');
                        return;
                    }
                } catch (_) {
                    sessionStorage.removeItem('mge:hireIntent');
                }
            }

            const raw = sessionStorage.getItem('mge:selectedContratistaForHire');
            if (!raw) return;

            try {
                const preselected = JSON.parse(raw);
                if (!preselected?.contratistaId) return;

                const select = document.getElementById('contratistaSelect');
                if (select.querySelector(`option[value="${preselected.contratistaId}"]`)) {
                    select.value = String(preselected.contratistaId);
                    onContratistaChange();
                }
            } catch (_) {
                // ignore malformed preselection
            } finally {
                sessionStorage.removeItem('mge:selectedContratistaForHire');
            }
        }

