        function inferContratistaTipo(contratista) {
            const tipoRaw = Number(contratista?.tipo ?? contratista?.tipoPersona ?? contratista?.tipoContratista ?? 0);
            if (tipoRaw === 2) return 2;

            const tipoIdentificacion = Number(contratista?.tipoIdentificacion ?? 0);
            if (tipoIdentificacion === 3) return 2;

            const rnc = (contratista?.rnc || contratista?.Rnc || '').replace(/\D/g, '');
            if (rnc.length >= 9) return 2;

            return 1;
        }

        function splitNombreCompleto(fullName) {
            const safe = String(fullName || '').trim().replace(/\s+/g, ' ');
            if (!safe) {
                return { nombre: 'Contratista', apellido: '-' };
            }

            const parts = safe.split(' ');
            if (parts.length === 1) {
                return { nombre: parts[0], apellido: '-' };
            }

            return {
                nombre: parts.shift() || 'Contratista',
                apellido: parts.join(' ') || '-'
            };
        }

        function getValidationDetails(payload) {
            const items = [];
            const details = payload?.details;
            if (Array.isArray(details)) {
                details.forEach(item => {
                    if (typeof item === 'string' && item.trim()) {
                        items.push(item.trim());
                        return;
                    }
                    if (item && typeof item === 'object') {
                        const field = item.field || item.propertyName || item.key || '';
                        const message = item.error || item.message || item.errorMessage || '';
                        if (message) {
                            items.push(field ? `${field}: ${message}` : message);
                        }
                    }
                });
            }

            const errors = payload?.errors;
            if (errors && typeof errors === 'object') {
                Object.entries(errors).forEach(([field, messages]) => {
                    const list = Array.isArray(messages) ? messages : [messages];
                    list.forEach(message => {
                        if (typeof message === 'string' && message.trim()) {
                            items.push(`${field}: ${message.trim()}`);
                        }
                    });
                });
            }

            return [...new Set(items)];
        }

        function normalizeEntityId(payload) {
            if (typeof payload === 'number') return payload;
            if (!payload || typeof payload !== 'object') return 0;
            return Number(payload.id || payload.detalleId || payload.contratacionId || payload.result || 0);
        }

        function buildCreateTemporalPayload(contratista, formState) {
            const nombreContratista = (contratista.nombreCompleto || `${contratista.nombre || ''} ${contratista.apellido || ''}`.trim()).trim();
            const nombrePartes = splitNombreCompleto(nombreContratista);
            const contratistaTipo = inferContratistaTipo(contratista);
            const esJuridica = contratistaTipo === 2;
            const identificacionLimpia = (contratista.identificacion || '').replace(/\D/g, '');
            const rncLimpio = (contratista.rnc || contratista.Rnc || identificacionLimpia || '').replace(/\D/g, '');
            const nombreComercial = (contratista.nombreComercial || contratista.nombreEmpresa || nombreContratista || '').trim();

            if (esJuridica && (!nombreComercial || !rncLimpio)) {
                throw new Error('El contratista jurídico debe tener nombre comercial y RNC para crear la contratación temporal.');
            }

            const payload = {
                tipo: contratistaTipo,
                telefono: contratista.telefono1 || null,
                direccion: contratista.provincia || null,
                email: contratista.email || null,
                servicio: formState.servicioNombre || 'Servicio general',
                fechaInicio: formState.fechaInicio,
                fechaFinal: formState.fechaFin,
                pago: formState.monto,
                estatus: 1
            };

            if (esJuridica) {
                payload.nombreComercial = nombreComercial;
                payload.rnc = rncLimpio;
            } else {
                payload.nombre = nombrePartes.nombre;
                payload.apellido = nombrePartes.apellido;
                payload.identificacion = identificacionLimpia || `${formState.contratistaId}`;
            }

            return payload;
        }

        function buildCreateContratacionPayload(temporalId, formState) {
            return {
                contratacionId: temporalId,
                contratistaId: formState.contratistaId,
                servicioId: formState.servicioId || null,
                descripcionCorta: formState.descripcionCorta,
                descripcionAmpliada: formState.descripcionAmpliada || null,
                fechaInicio: formState.fechaInicio,
                fechaFinal: formState.fechaFin,
                montoAcordado: formState.monto,
                esquemaPagos: formState.esquemaPagos || null,
                notas: formState.notas || null
            };
        }
        
        async function crearContratacion() {
            const token = getAuthToken();
            if (!token) {
                Swal.fire('Error', 'Debe iniciar sesión', 'error');
                return;
            }
            
            // Validar términos
            if (!document.getElementById('chkTerminos').checked) {
                Swal.fire('Error', 'Debe aceptar los términos y condiciones', 'error');
                return;
            }
            
            // Validar campos
            const descripcionCorta = document.getElementById('descripcionCorta').value.trim();
            const fechaInicio = document.getElementById('fechaInicio').value;
            const fechaFin = document.getElementById('fechaFin').value;
            const montoStr = document.getElementById('montoAcordado').value.replace(/,/g, '');
            const monto = parseFloat(montoStr);
            const contratistaId = parseInt(document.getElementById('contratistaSelect').value || '0');
            const servicioId = parseInt(document.getElementById('servicioSelect').value || '0');
            
            if (!contratistaId) {
                Swal.fire('Error', 'Debe seleccionar un contratista', 'error');
                return;
            }

            if (!descripcionCorta || !fechaInicio || !fechaFin || isNaN(monto) || monto <= 0) {
                Swal.fire('Error', 'Complete todos los campos requeridos correctamente', 'error');
                return;
            }
            
            if (new Date(fechaFin) < new Date(fechaInicio)) {
                Swal.fire('Error', 'La fecha de fin debe ser posterior a la fecha de inicio', 'error');
                return;
            }
            
            const contratista = modalContratistas.find(c => c.contratistaId === contratistaId);
            if (!contratista) {
                Swal.fire('Error', 'No se encontró la información del contratista seleccionado', 'error');
                return;
            }
            
            // Confirmar
            const confirm = await Swal.fire({
                title: '¿Crear contratación?',
                html: `
                    <p><strong>${descripcionCorta}</strong></p>
                    <p>Monto: <strong>RD$ ${monto.toLocaleString('en-US', {minimumFractionDigits: 2})}</strong></p>
                    <p>Período: ${new Date(fechaInicio).toLocaleDateString('es-DO')} - ${new Date(fechaFin).toLocaleDateString('es-DO')}</p>
                    <p>Contratista: <strong>${contratista.nombreCompleto || `${contratista.nombre || ''} ${contratista.apellido || ''}`.trim()}</strong></p>
                `,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-check me-1"></i>Sí, crear',
                cancelButtonText: 'Cancelar'
            });
            
            if (!confirm.isConfirmed) return;
            
            try {
                document.getElementById('btnGuardarContratacion').disabled = true;
                document.getElementById('btnGuardarContratacion').innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Creando...';

                const servicioSeleccionado = document.getElementById('servicioSelect');
                const formState = {
                    contratistaId,
                    servicioId,
                    servicioNombre: servicioSeleccionado.options[servicioSeleccionado.selectedIndex]?.text || 'Servicio general',
                    descripcionCorta,
                    descripcionAmpliada: document.getElementById('descripcionAmpliada').value.trim(),
                    fechaInicio,
                    fechaFin,
                    monto,
                    esquemaPagos: document.getElementById('esquemaPagos').value,
                    notas: document.getElementById('notas').value.trim()
                };
                const temporalPayload = buildCreateTemporalPayload(contratista, formState);

                console.debug('CREATE_TEMPORAL_START', { contratistaId, servicioId, fechaInicio, fechaFin, monto });
                const temporalPath = window.API_ENDPOINTS?.EMPLEADOS?.TEMPORALES_CREATE;
                if (!temporalPath) {
                    throw new Error('No se encontró API_ENDPOINTS.EMPLEADOS.TEMPORALES_CREATE');
                }
                const temporalResponse = await authenticatedFetch(temporalPath, {
                    method: 'POST',
                    body: JSON.stringify(temporalPayload)
                });

                if (!temporalResponse.ok) {
                    const temporalError = window.readApiResponse ? await window.readApiResponse(temporalResponse) : await temporalResponse.json();
                    const message = window.getApiErrorMessage
                        ? window.getApiErrorMessage(temporalError, 'No se pudo crear la contratación temporal base')
                        : (temporalError?.error || 'No se pudo crear la contratación temporal base');
                    const error = new Error(message);
                    error.validationDetails = getValidationDetails(temporalError);
                    throw error;
                }

                const temporalResult = window.readApiResponse ? await window.readApiResponse(temporalResponse) : await temporalResponse.json();
                const contratacionId = normalizeEntityId(temporalResult);
                if (!contratacionId) {
                    throw new Error('No se recibió el identificador de contratación temporal');
                }

                const command = buildCreateContratacionPayload(contratacionId, formState);
                
                const createPath = window.API_ENDPOINTS?.CONTRATACIONES?.CREATE || '/contrataciones';
                console.debug('CREATE_CONTRATACION_START', { contratacionId, contratistaId, servicioId, createPath });
                const response = await authenticatedFetch(createPath, {
                    method: 'POST',
                    body: JSON.stringify(command)
                });
                
                if (response.ok) {
                    const createResult = window.readApiResponse ? await window.readApiResponse(response) : await response.json();
                    const detalleId = normalizeEntityId(createResult);
                    
                    // Cerrar modal
                    bootstrap.Modal.getInstance(document.getElementById('modalNuevaContratacion')).hide();
                    
                    // Mostrar éxito
                    await Swal.fire({
                        title: '¡Contratación Creada!',
                        html: `<p>ID de contratación: <strong>#${detalleId}</strong></p>`,
                        icon: 'success',
                        confirmButtonText: 'Aceptar'
                    });
                    
                    // Recargar datos
                    loadContrataciones();
                } else {
                    const error = window.readApiResponse ? await window.readApiResponse(response) : await response.json();
                    const message = window.getApiErrorMessage
                        ? window.getApiErrorMessage(error, 'No se pudo crear la contratación')
                        : (error?.message || error?.error || 'No se pudo crear la contratación');
                    Swal.fire('Error', message, 'error');
                }
            } catch (error) {
                console.error('CREATE_CONTRATACION_FAIL', error);
                const userMessage = error?.message || 'No se pudo completar la creación de la contratación temporal';
                const details = Array.isArray(error?.validationDetails) ? error.validationDetails : [];
                const detailHtml = details.length
                    ? `<ul class="text-start mb-0">${details.map(d => `<li>${d}</li>`).join('')}</ul>`
                    : '';
                Swal.fire({
                    title: 'Error',
                    html: detailHtml || userMessage,
                    icon: 'error'
                });
            } finally {
                document.getElementById('btnGuardarContratacion').disabled = false;
                document.getElementById('btnGuardarContratacion').innerHTML = '<i class="fas fa-save me-1"></i>Crear Contratación';
            }
        }
        
