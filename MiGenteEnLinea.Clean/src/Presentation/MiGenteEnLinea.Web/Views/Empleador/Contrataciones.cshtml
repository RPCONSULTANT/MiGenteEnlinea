                return;
            }
            
            const filtered = allAceptadas.filter(c => 
                (c.descripcionCorta || '').toLowerCase().includes(term)
            );
            
            renderFilteredTable('tbodyAceptadas', filtered, 7, renderAceptadasRow);
        }
        
        function filterActivas() {
