        async function verContratoTemporal(detalleId) {
            try {
                const contratoPath = window.API_ENDPOINTS?.CONTRATACIONES?.CONTRATO_PDF
                    ? window.API_ENDPOINTS.CONTRATACIONES.CONTRATO_PDF(detalleId)
                    : null;
                if (!contratoPath) {
                    throw new Error('No se encontró API_ENDPOINTS.CONTRATACIONES.CONTRATO_PDF');
                }
                const response = await authenticatedFetch(contratoPath);
                if (!response.ok) {
                    const payload = window.readApiResponse ? await window.readApiResponse(response) : await response.json();
                    const message = window.getApiErrorMessage
                        ? window.getApiErrorMessage(payload, 'No se pudo generar el contrato')
                        : (payload?.message || payload?.error || 'No se pudo generar el contrato');
                    Swal.fire('Error', message, 'error');
                    return;
                }

                const blob = await response.blob();
                const objectUrl = URL.createObjectURL(blob);
                window.open(objectUrl, '_blank', 'noopener');
                setTimeout(() => URL.revokeObjectURL(objectUrl), 60000);
            } catch (error) {
                console.error('Error generando contrato temporal:', error);
