@{
    ViewData["Title"] = "Inicio";
    Layout = "_LayoutLanding";
}

<style>
    .bannerSoyTuGente {
        background-color: #00176B;
        color: white;
        padding: 20px;
        display: flex;
        align-items: center;
    }

    .bannerSoyTuGente-description {
        flex: 1;
        margin-right: 20px;
    }

    .bannerSoyTuGente-title {
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .bannerSoyTuGente-button {
        background-color: #ffffff;
        color: #00176B;
        border: none;
        padding: 10px 20px;
        font-size: 18px;
        font-weight: bold;
        cursor: pointer;
    }
</style>

<!-- Banner Principal -->
<div class="banner">
    <div class="banner-content">
        <h1 class="headerText animate__animated animate__slideInLeft">Soluciones integrales de auto gestion y construccion de referencias</h1>
        <a class="btn btn-primary btn-lg" style="padding: 15px;" href="@Url.Action("Planes", "Home")">Conoce mas sobre Mi Gente</a>
    </div>
</div>

<!-- Sub Banner -->
<div class="container col col-lg-12 form-control" style="background-color: #00176B; width: auto; color: white; text-align: center;">
    <h6 class="animate__animated animate__heartBeat animate__infinite animate__slower" style="margin: 10px">La solucion para el manejo de tus procesos laborales</h6>
</div>

<!-- Buscador / Directorio -->
<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-body text-center py-4">
            <h2 class="headerText mb-2">Busca suplidores, contratistas y profesionales</h2>
            <p class="text-muted mb-3">Explora el directorio, consulta perfiles y valida referencias desde la primera pantalla.</p>
            <a class="btn btn-primary btn-lg me-2" href="@Url.Action("Directorio", "Contratista")">Buscar suplidores</a>
            <a class="btn btn-outline-primary btn-lg" href="@Url.Action("Planes", "Home")#faqSection">Ver cómo funciona</a>
        </div>
    </div>
</div>

<!-- Sección Por qué usar Mi Gente -->
<div class="container">
    <div class="form-inline">
        <h1 class="headerText">Por que usar </h1>
        <h1 class="headerText" style="margin-left: 8px; font-weight: bold; color: #2460FC">Mi Gente?</h1>
    </div>
    <div class="form-inline align-content-center">
        <!-- Card: Gestión de Trabajadores -->
        <a class="link" href="@Url.Action("Empleados", "Empleador")">
            <div class="card text-center" style="width: 15rem; text-align: center; margin: 15px; transition: background-color 2s ease-out 100ms">
                <div class="inline ">
                    <img class="center-block" src="~/images/workers.png" style="max-width: 70px;" alt="Gestión de Trabajadores" />
                </div>
                <div class="card-body">
                    <p class="font-weight-bold" style="color: black; font-size: medium">Gestión de Trabajadores</p>
                    <p class="card-text">Lleva un control de tus colaboradores en todo momento.</p>
                </div>
            </div>
        </a>
        
        <!-- Card: Pago de Nómina -->
        <a class="link" href="@Url.Action("Nomina", "Empleador")">
            <div class="card text-center" style="width: 15rem; text-align: center; margin: 15px;">
                <div class="inline">
                    <img class="center-block" src="~/images/moneyIcon.png" style="max-width: 70px;" alt="Pago de Nómina" />
                </div>
                <div class="card-body">
                    <p class="font-weight-bold" style="color: black; font-size: medium">Pago de Nomina</p>
                    <p class="card-text">Gestiona tu nomina de una manera eficiente y rapida en la palma de tu mano</p>
                </div>
            </div>
        </a>
        
        <!-- Card: Cálculo de Prestaciones -->
        <a class="link" target="_blank" href="https://calculo.mt.gob.do/">
            <div class="card text-center" style="width: 15rem; text-align: center; margin: 15px;">
                <div class="inline">
                    <img class="center-block" src="~/images/calculatorIcon.png" style="max-width: 70px;" alt="Cálculo de Prestaciones" />
                </div>
                <div class="card-body">
                    <p class="font-weight-bold" style="color: black; font-size: medium">Calculo de Prestaciones</p>
                    <p class="card-text">Realiza el calculo de las prestaciones de tu colaborador para generar recibo de descargo</p>
                </div>
            </div>
        </a>
        
        <!-- Card: Documentación Legal -->
        <a class="link" href="@Url.Action("FAQ", "Home")">
            <div class="card text-center" style="width: 15rem; text-align: center; margin: 15px;">
                <div class="inline">
                    <img class="center-block" src="~/images/legalDocIcon.png" style="max-width: 70px;" alt="Documentación Legal" />
                </div>
                <div class="card-body">
                    <p class="font-weight-bold" style="color: black; font-size: medium">Documentacion Legal</p>
                    <p class="card-text">Genera facilmente los documentos legales que necesitas en tu proceso de contratacion</p>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Sección Calificación de Perfiles -->
<div class="container">
    <h1 class="headerText">Cuentas con un directorio de contratistas y profesionales con su historial de comportamiento</h1>
    <hr />
    <h1 class="headerText" style="color: #2460FC; margin-top: -15px;">Contratistas y Profesionales</h1>
</div>

<div class="container profile-page">
    <div class="row" id="homeProfiles">
        <div class="col-12 text-center text-muted py-4">
            Cargando perfiles destacados...
        </div>
    </div>
</div>

<!-- Banner Soy Tu Gente -->
<div class="bannerSoyTuGente mt-4">
    <div class="bannerSoyTuGente-description">
        <div class="bannerSoyTuGente-title">¿Eres un profesional?</div>
        <p>Únete a nuestra comunidad de profesionales y comienza a recibir ofertas de trabajo.</p>
    </div>
    <button class="bannerSoyTuGente-button" onclick="window.location.href='@Url.Action("Registrar", "Auth")'">
        ¡Regístrate Ahora!
    </button>
</div>

<!-- Footer Space -->
<div style="height: 50px;"></div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            loadHomeProfiles();
        });

        async function loadHomeProfiles() {
            const container = document.getElementById('homeProfiles');
            if (!container) return;

            try {
                const { response, payload } = await window.requestApi('/contratistas?soloActivos=true&pageSize=2', {}, { auth: false });
                if (!response.ok) {
                    throw new Error(window.getApiErrorMessage(payload, 'No se pudieron cargar los perfiles destacados.'));
                }

                const perfiles = Array.isArray(payload) ? payload : (payload?.contratistas || payload?.items || []);
                if (!perfiles.length) {
                    container.innerHTML = `
                        <div class="col-12 text-center text-muted py-4">
                            No hay perfiles destacados disponibles por el momento.
                        </div>
                    `;
                    return;
                }

                container.innerHTML = perfiles.map(perfil => {
                    const nombre = `${perfil.nombre || ''} ${perfil.apellido || ''}`.trim() || perfil.nombreComercial || perfil.titulo || 'Perfil profesional';
                    const sector = perfil.sector || perfil.titulo || 'Contratista';
                    const provincia = perfil.provincia || 'República Dominicana';
                    const rating = Number(perfil.promedioCalificacion || 0);
                    const imageUrl = perfil.fotoUrl || perfil.imagenUrl || '/images/circular1.png';

                    return `
                        <div class="col-xl-6 col-lg-7 col-md-12">
                            <div class="card profile-header">
                                <div class="body">
                                    <div class="row">
                                        <div class="col-lg-4 col-md-4 col-12">
                                            <div class="profile-image float-md-right">
                                                <img src="${imageUrl}" alt="${nombre}" onerror="this.onerror=null; this.src='/images/circular1.png';">
                                            </div>
                                        </div>
                                        <div class="col-lg-8 col-md-8 col-12">
                                            <h4 class="m-t-0 m-b-0">${nombre}</h4>
                                            <span class="job_post">${sector}</span>
                                            <p>${provincia}</p>
                                            <div>
                                                <a class="btn btn-primary btn-round" href="@Url.Action("Directorio", "Contratista")">Ver Perfil</a>
                                                <a class="btn btn-primary btn-round btn-simple" href="@Url.Action("Directorio", "Contratista")">Enviar Mensaje</a>
                                            </div>
                                            <div class="divCalificacionCard">
                                                <a>Calificación</a>
                                                ${window.renderStars ? window.renderStars(rating) : ''}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                }).join('');
            } catch (error) {
                console.error('Error cargando perfiles destacados:', error);
                container.innerHTML = `
                    <div class="col-12 text-center text-muted py-4">
                        No fue posible cargar los perfiles destacados en este momento.
                    </div>
                `;
            }
        }
    </script>
}
