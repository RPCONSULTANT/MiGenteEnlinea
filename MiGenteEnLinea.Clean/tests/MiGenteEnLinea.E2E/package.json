{
  "name": "migenteenlinea-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright E2E suite for MiGenteEnLinea public web+api",
  "scripts": {
    "test": "powershell -ExecutionPolicy Bypass -File ../../scripts/env/Invoke-E2EOneCommand.ps1",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:full": "playwright test --grep @full",
    "test:e2e:all": "playwright test --grep \"@smoke|@full\"",
    "test:e2e:module": "playwright test",
    "report:open": "playwright show-report",
    "report:summary": "node ./scripts/generate-summary.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
